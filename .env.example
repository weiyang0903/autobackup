# ==========================================
# XAMPP MySQL AutoBackup - Environment Configuration
# ==========================================

# MySQL Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Path to mysqldump executable in your XAMPP installation
# Default on Windows XAMPP: C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe

# Default Backup Storage Directory (Absolute path or relative to project root)
# Example: ./backups or D:\mysql_backups
DEFAULT_BACKUP_DIR=./backups

# Application Server Port
PORT=3003

# Authentication & Session Security (Optional, recommended for production)
# SESSION_SECRET=your-custom-secret-key-at-least-32-chars
# INITIAL_ADMIN_PASSWORD=admin123

