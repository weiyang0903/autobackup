    "id": "sched_example_2",
    "name": "Workday Nightly Backup",
    "databases": ["my_project_db", "analytics_db"],
    "frequencyType": "weekly",
    "weekDays": [1, 2, 3, 4, 5],
    "times": ["22:30"],
    "cronExpressions": ["30 22 * * 1,2,3,4,5"],
    "backupDir": "./backups",
    "enabled": true,
